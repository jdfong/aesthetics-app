# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys.
# Set the same variables in Vercel: Project -> Settings -> Environment Variables.
# Server-only: none of these are exposed to the browser (no NEXT_PUBLIC_ prefix).

# Project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-only; never share or commit it.
# Used from phase 2 for database access.
SUPABASE_SECRET_KEY=
